# Template cấu hình được phép commit. Không điền API key thật vào file này.
# Sao chép các giá trị cần dùng sang file .env local đã được Git ignore.

LESSONS_DIR=
VECTOR_STORE_DIR=
COLLECTION_NAME=ai_in_action_lessons

# Semantic embedding API
# Khi dùng OpenAI, để EMBEDDING_BASE_URL trống để SDK dùng endpoint mặc định.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openai.com
EMBEDDING_DIMENSION=3072
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=3

# Optional local embedding fallback
LOCAL_EMBEDDING_MODEL=

# LLM API
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_REASONING_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=80
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_SCORE_THRESHOLD=0.12
RETRIEVAL_MIN_LEXICAL_COVERAGE=0.4
RETRIEVAL_MIN_VECTOR_SCORE=0.28
OCR_ENABLED=true
OCR_LANGUAGES=vie+eng
OCR_DPI=240
